# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Spend protection for the billed routes (optional — these defaults apply if unset).
# Per visitor, per hour:
# ANALYZE_PER_IP_PER_HOUR=10
# Across all visitors, per UTC day:
# DAILY_AI_CALL_CAP=25
# Across all visitors, per 30-day window:
# MONTHLY_AI_CALL_CAP=200
# Any random string; mixed into the hash of visitor addresses so they can't be reversed:
# RATE_LIMIT_SALT=
